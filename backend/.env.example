# T-Bank (Tinkoff) Invest API Token (read-only is sufficient for market data)
TINKOFF_TOKEN=t.your_api_token_here
TINKOFF_ENDPOINT=invest-public-api.tbank.ru:443
# Set to false to bypass Russian Root CA (Минцифры) validation error in Node.js
TINKOFF_REJECT_UNAUTHORIZED=false

# Network Configuration
PORT=8080
HOST=127.0.0.1
LOG_LEVEL=info

# Default MOEX Instruments to Subscribe (comma-separated tickers)
DEFAULT_TICKERS=SBER,GAZP,LKOH,GMKN,ROSN,NVTK,YNDX,VTBR

# Telegram Notifications (optional 24/7 background alerts)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
